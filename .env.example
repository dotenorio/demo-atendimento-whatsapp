# Copie para .env.local. Sem nada configurado, o robô responde pelo roteiro de exemplo (sem IA) e não grava no CRM.

# IA (opcional): chave da API do Claude. Fica SÓ no servidor, nunca vai para o navegador.
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5)
CLAUDE_MODELO=

# Mini CRM (demo 2): endereço e chave da API /api/v1
# Ex.: CRM_API_URL=http://localhost:3001 e CRM_API_CHAVE=demo-chave-publica-mini-crm
CRM_API_URL=
CRM_API_CHAVE=
# Endereço das telas do CRM para o link "Abrir o contato" (padrão: o mesmo da API)
CRM_PAINEL_URL=

# Obrigatório em produção: 32+ caracteres aleatórios (assina a conversa do simulador)
CONVERSA_SEGREDO=

# Limites da demo pública (padrões: 15, 40 e 300)
LIMITE_MENSAGENS_CONVERSA=
LIMITE_MENSAGENS_IP_DIA=
LIMITE_IA_DIA=
# "false" desliga o simulador (num cliente real, só o webhook do WhatsApp fica no ar)
SIMULADOR=

# WhatsApp Cloud API (opcional; ver "Ligar no WhatsApp de verdade" no README)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSAO=
